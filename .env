# Read by `docker compose` at the repo root for variable substitution in
# docker-compose.yml (a separate mechanism from Backend-API/.env, which is
# what the api container actually gets as its app config via env_file).
# Not app settings — don't add JWT/DB/S3 app keys here, they belong in
# Backend-API/.env.

# This VPS already has something else on host port 8010 (another project),
# so the api container is remapped here. Local dev elsewhere keeps the
# default (8010) since this var is simply unset there.
API_HOST_PORT=8021

# Public origin the API's presigned S3/MinIO URLs are rewritten to (see
# core/storage.py) so a browser can actually reach them — nginx proxies
# /medical-practice-documents/ on this domain through to MinIO.
S3_PUBLIC_ENDPOINT_URL=https://carnet.digitalko.space
